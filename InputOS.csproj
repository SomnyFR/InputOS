<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <OutputType>WinExe</OutputType>
    <StartupObject>InputOS.Program</StartupObject>
    <Version>1.1.0</Version>

    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>

    <Nullable>enable</Nullable>

    <ImplicitUsings>enable</ImplicitUsings>

    <UseWPF>true</UseWPF>

    <UseWindowsForms>true</UseWindowsForms>

  </PropertyGroup>


  <!-- =========================================================================
       FONCTIONNALITÉ : RESSOURCES DE L'APPLICATION
       ========================================================================= -->

  <ItemGroup>

    <Resource Include="Assets\Icons\iOSBlack.ico" />

    <Resource Include="Assets\Icons\iOSBlack.png" />

    <Resource Include="Assets\Icons\iOSWhite.ico" />

    <Resource Include="Assets\Icons\iOSWhite.png" />

    <Resource Include="Assets\Icons\InputOSBlack.png" />

    <Resource Include="Assets\Icons\InputOSWhite.png" />

  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.6.4" />
    <Content Include="Config/diagnostic-settings.json" Link="diagnostic-settings.json" TargetPath="diagnostic-settings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <!-- =========================================================================
       FIN FONCTIONNALITÉ : RESSOURCES DE L'APPLICATION
       ========================================================================= -->

</Project>
