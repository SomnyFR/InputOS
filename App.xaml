<Application x:Class="InputOS.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>

        <!-- =========================================================================
             FONCTIONNALITÉ : APPARENCE DE L'APPLICATION
             ========================================================================= -->

        <!-- =====================================================================
             STYLE
             ===================================================================== -->

        <SolidColorBrush x:Key="AppBackgroundBrush"
                         Color="#15171B"/>

        <SolidColorBrush x:Key="AppForegroundBrush"
                         Color="#EDEEF0"/>

        <SolidColorBrush x:Key="AppPanelBrush"
                         Color="#1F2228"/>

        <SolidColorBrush x:Key="AppBorderBrush"
                         Color="#343945"/>

        <SolidColorBrush x:Key="AppAccentBrush"
                         Color="#00C2FF"/>

        <SolidColorBrush x:Key="AppSecondaryTextBrush"
                         Color="#9AA1AC"/>

        <!-- Sélection des éléments : reprend la couleur d'accent sur tout le thème sombre -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                         Color="#00C2FF"/>

        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                         Color="#15171B"/>

        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                         Color="#2A2F38"/>

        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                         Color="#EDEEF0"/>

        <SolidColorBrush x:Key="AppCardBrush"
                         Color="#1F2127"/>

        <SolidColorBrush x:Key="AppCardHoverBrush"
                         Color="#2A2D35"/>

        <!-- Boutons modernes pour toutes les fenêtres : coins arrondis, survol, appui, désactivé -->
        <Style TargetType="Button">

            <Setter Property="Background"
                    Value="{DynamicResource AppCardBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource AppForegroundBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource AppBorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="14,8"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource AppCardHoverBrush}"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AppAccentBrush}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource AppAccentBrush}"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.4"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- =========================================================================
             FIN FONCTIONNALITÉ : APPARENCE DE L'APPLICATION
             ========================================================================= -->

    </Application.Resources>

</Application>