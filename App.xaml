<Application x:Class="InputOS.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>

        <!-- =========================================================================
             FONCTIONNALITÉ : APPARENCE DE L'APPLICATION
             ========================================================================= -->

        <!-- =====================================================================
             STYLE
             ===================================================================== -->

        <SolidColorBrush x:Key="AppBackgroundBrush"
                         Color="#F3F3F3"/>

        <SolidColorBrush x:Key="AppForegroundBrush"
                         Color="#1A1A1A"/>

        <SolidColorBrush x:Key="AppPanelBrush"
                         Color="#FFFFFF"/>

        <SolidColorBrush x:Key="AppBorderBrush"
                         Color="#BDBDBD"/>

        <SolidColorBrush x:Key="AppAccentBrush"
                         Color="#0078D4"/>

        <SolidColorBrush x:Key="AppSecondaryTextBrush"
                         Color="#666666"/>

        <!-- =========================================================================
             FIN FONCTIONNALITÉ : APPARENCE DE L'APPLICATION
             ========================================================================= -->

    </Application.Resources>

</Application>