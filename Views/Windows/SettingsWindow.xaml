<Window x:Class="InputOS.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="{DynamicResource Settings.Title}"
        Icon="/InputOS;component/Assets/Icons/iOSBlack.ico"

        Width="460"
        Height="700"

        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"

        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}">

    <Window.Resources>

        <!-- =====================================================================
             STYLE
             ===================================================================== -->

        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{DynamicResource AppCardBrush}"/>

            <Setter Property="CornerRadius"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="22"/>

            <Setter Property="Margin"
                    Value="0,0,0,16"/>

        </Style>


        <Style x:Key="SectionTitleStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource AppSecondaryTextBrush}"/>

            <Setter Property="Margin"
                    Value="0,0,0,16"/>

        </Style>


        <!-- Interrupteur : une case à cocher présentée comme un bouton à bascule. -->
        <Style x:Key="ToggleSwitchStyle"
               TargetType="CheckBox">

            <Setter Property="Foreground"
                    Value="{DynamicResource AppForegroundBrush}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="CheckBox">

                        <Grid Background="Transparent">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontWeight="SemiBold"/>

                            <Border x:Name="Track"
                                    Grid.Column="1"
                                    Width="46"
                                    Height="26"
                                    CornerRadius="13"
                                    Background="{DynamicResource AppBorderBrush}"
                                    Margin="16,0,0,0">

                                <Ellipse x:Name="Thumb"
                                         Width="18"
                                         Height="18"
                                         Fill="White"
                                         HorizontalAlignment="Left"
                                         Margin="4,0,0,0"/>

                            </Border>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked"
                                     Value="True">

                                <Setter TargetName="Track"
                                        Property="Background"
                                        Value="{DynamicResource AppAccentBrush}"/>

                                <Setter TargetName="Thumb"
                                        Property="HorizontalAlignment"
                                        Value="Right"/>

                                <Setter TargetName="Thumb"
                                        Property="Margin"
                                        Value="0,0,4,0"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter Property="Opacity"
                                        Value="0.4"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,26,28,20">

        <TextBlock Text="{DynamicResource Settings.Heading}"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,22"/>


        <!-- =========================================================================
             FONCTIONNALITÉ : PARAMÈTRES DE FENÊTRE
             ========================================================================= -->

        <Border Style="{StaticResource CardStyle}">

            <StackPanel>

                <TextBlock Text="{DynamicResource Settings.Window.Section}"
                           Style="{StaticResource SectionTitleStyle}"/>

                <CheckBox x:Name="CloseToTrayCheckBox"
                          Content="{DynamicResource Settings.Window.CloseToTray}"
                          Style="{StaticResource ToggleSwitchStyle}"
                          VerticalAlignment="Center"/>

            </StackPanel>

        </Border>

        <!-- =========================================================================
             FIN FONCTIONNALITÉ : PARAMÈTRES DE FENÊTRE
             ========================================================================= -->


        <!-- FONCTIONNALITÉ : LANGUE DE L'INTERFACE -->
        <Border Style="{StaticResource CardStyle}">

            <StackPanel>

                <TextBlock Text="{DynamicResource Settings.Language.Section}"
                           Style="{StaticResource SectionTitleStyle}"/>

                <TextBlock Text="{DynamicResource Settings.Language.Label}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <ComboBox x:Name="LanguageComboBox"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Code"
                          Margin="0,0,0,12"/>

                <TextBlock Text="{DynamicResource Settings.Language.Note}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource AppSecondaryTextBrush}"/>

            </StackPanel>

        </Border>
        <!-- FIN FONCTIONNALITÉ : LANGUE DE L'INTERFACE -->


        <!-- FONCTIONNALITÉ : MISES À JOUR DE L'APPLICATION -->
        <Border Style="{StaticResource CardStyle}">

            <StackPanel>

                <TextBlock Text="{DynamicResource Settings.Updates.Section}"
                           Style="{StaticResource SectionTitleStyle}"/>

                <TextBlock x:Name="UpdateStatusText"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>

                <Button x:Name="CheckUpdatesButton"
                        Content="{DynamicResource Settings.Updates.Check}"
                        Margin="0,0,0,10"
                        Click="CheckUpdatesButton_Click"/>

                <Button x:Name="RestartForUpdateButton"
                        Content="{DynamicResource Settings.Updates.Restart}"
                        Visibility="Collapsed"
                        Click="RestartForUpdateButton_Click"/>

                <TextBlock Text="{DynamicResource Settings.Updates.Note}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource AppSecondaryTextBrush}"
                           Margin="0,14,0,0"/>

            </StackPanel>

        </Border>
        <!-- FIN FONCTIONNALITÉ : MISES À JOUR DE L'APPLICATION -->


        <!-- FONCTIONNALITÉ : CACHE -->
        <Border Style="{StaticResource CardStyle}">

            <StackPanel>

                <TextBlock Text="{DynamicResource Settings.Cache.Section}"
                           Style="{StaticResource SectionTitleStyle}"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings.Cache.Profiles}"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="ProfilesSizeText"
                                   Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{DynamicResource Settings.Cache.Delete}"
                            Padding="12,4"
                            Click="DeleteProfilesButton_Click"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings.Cache.Logs}"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="LogsSizeText"
                                   Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                        <TextBlock Text="{DynamicResource Settings.Cache.NoLogs}"
                                   Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{DynamicResource Settings.Cache.Delete}"
                            Padding="12,4"
                            IsEnabled="False"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings.Cache.Misc}"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="SettingsSizeText"
                                   Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{DynamicResource Settings.Cache.Delete}"
                            Padding="12,4"
                            Click="DeleteSettingsButton_Click"/>
                </Grid>

            </StackPanel>

        </Border>
        <!-- FIN FONCTIONNALITÉ : CACHE -->

    </StackPanel>
    </ScrollViewer>

</Window>
