<Window x:Class="InputOS.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="InputOS - Paramètres"
        Icon="/InputOS;component/Assets/Icons/iOSBlack.ico"

        Width="390"
        Height="520"

        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"

        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}">

    <StackPanel Margin="10">


        <!-- =========================================================================
             FONCTIONNALITÉ : PARAMÈTRES DE FENÊTRE
             ========================================================================= -->

        <Border BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="2"
                Padding="0,8,0,0"
                VerticalAlignment="Top">

            <Grid>

                <!-- =====================================================================
                     TITRE DE SECTION
                     ===================================================================== -->

                <TextBlock Text="Fenêtre"
                           Foreground="{DynamicResource AppForegroundBrush}"
                           Background="{DynamicResource AppBackgroundBrush}"
                           Margin="8,-17,0,0"
                           Padding="4,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>


                <!-- =====================================================================
                     INTERFACE
                     ===================================================================== -->

                <StackPanel Margin="15">

                    <CheckBox x:Name="CloseToTrayCheckBox"
                              Content="Minimiser en arrière-plan"
                              Foreground="{DynamicResource AppForegroundBrush}"
                              VerticalAlignment="Center"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- =========================================================================
             FIN FONCTIONNALITÉ : PARAMÈTRES DE FENÊTRE
             ========================================================================= -->


        <!-- FONCTIONNALITÉ : MISES À JOUR DE L'APPLICATION -->
        <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="15" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Text="Mises à jour" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <Button x:Name="CheckUpdatesButton" Content="Vérifier les mises à jour" Padding="8" Margin="0,0,0,8" Click="CheckUpdatesButton_Click"/>
                <Button x:Name="RestartForUpdateButton" Content="Redémarrer pour mettre à jour" Padding="8" Visibility="Collapsed" Click="RestartForUpdateButton_Click"/>
                <TextBlock Text="Les profils locaux et les paramètres sont conservés. Fermez vos configurations en cours avant de redémarrer." TextWrapping="Wrap" Foreground="{DynamicResource AppSecondaryTextBrush}" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
        <!-- FIN FONCTIONNALITÉ : MISES À JOUR DE L'APPLICATION -->
    </StackPanel>

</Window>
