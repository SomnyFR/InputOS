<Window x:Class="InputOS.ControllerSuggestionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InputOS - Suggérer une manette"
        Icon="/InputOS;component/Assets/Icons/iOSBlack.ico"
        Width="740"
        Height="800"
        MinWidth="560"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}">

    <Grid Margin="24">

        <Grid.Resources>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Background" Value="{DynamicResource AppPanelBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
            <Style x:Key="NavigationButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="90"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="Margin" Value="10,0,0,0"/>
                <Setter Property="Background" Value="{DynamicResource AppPanelBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- =========================================================================
             FONCTIONNALITÉ : NOM DE LA CONFIGURATION MANETTE
             ========================================================================= -->

        <ScrollViewer x:Name="ConfigurationScrollViewer" Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,0,0,15">

        <Grid>

        <StackPanel x:Name="ModelSelectionPanel">
            <TextBlock Text="ÉTAPE 1 / 5 · VOTRE MANETTE"
                       Foreground="{DynamicResource AppAccentBrush}" FontWeight="SemiBold" Margin="0,0,0,12"/>

            <TextBlock Text="Donnons un nom à votre manette" FontSize="24"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Choisissez un modèle, ou indiquez son nom avec « Autre modèle ». Gardez le câble USB branché."
                       TextWrapping="Wrap"
                       Margin="0,0,0,15"/>

            <TextBlock x:Name="ControllerInformationText"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource AppSecondaryTextBrush}"
                       Margin="0,0,0,15"/>

            <TextBlock Text="Modèle de la manette" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ComboBox x:Name="ControllerModelComboBox"
                      Padding="8,5"
                      Background="{DynamicResource AppPanelBrush}"
                      Foreground="{DynamicResource AppForegroundBrush}"
                      BorderBrush="{DynamicResource AppBorderBrush}"
                      SelectionChanged="ControllerModelComboBox_SelectionChanged"/>

            <StackPanel x:Name="CustomModelPanel"
                        Visibility="Collapsed"
                        Margin="0,15,0,0">

                <TextBlock Text="Nom du modèle :"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="CustomModelTextBox"
                         MaxLength="100"
                         Padding="8,5"
                         Background="{DynamicResource AppPanelBrush}"
                         Foreground="{DynamicResource AppForegroundBrush}"
                         BorderBrush="{DynamicResource AppBorderBrush}"
                         TextChanged="CustomModelTextBox_TextChanged"/>

            </StackPanel>

            <TextBlock x:Name="ConfigurationNameText"
                       Text="Sélectionnez un modèle."
                       TextWrapping="Wrap"
                       Margin="0,15,0,0"/>

        </StackPanel>

        <!-- =========================================================================
             FONCTIONNALITÉ : PRÉPARATION DE LA CONFIGURATION
             ========================================================================= -->

        <StackPanel x:Name="ConfigurationPreparationPanel"
                    Visibility="Collapsed">

            <TextBlock Text="ÉTAPE 2 / 5 · PREMIÈRE DÉTECTION"
                       Foreground="{DynamicResource AppAccentBrush}" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock Text="Découvrons votre manette"
                       FontWeight="SemiBold" FontSize="24" Margin="0,0,0,8"/>
            <TextBlock Text="Lancez la détection, puis observez les commandes en direct."
                       TextWrapping="Wrap" Margin="0,0,0,20"/>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="VOTRE CONFIGURATION" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppSecondaryTextBrush}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="ConfigurationSummaryText" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="1. Lire les informations" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                    <TextBlock Text="Posez la manette au repos, avec son câble USB branché."
                               TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Button x:Name="AutoDetectButton" Content="Détecter automatiquement"
                            HorizontalAlignment="Left" Padding="16,10"
                            Background="{DynamicResource AppAccentBrush}" Foreground="White"
                            BorderThickness="0" Click="AutoDetectButton_Click"/>
                    <TextBlock x:Name="AutoDetectionResultText"
                               Text="Prêt à détecter. Aucune manipulation nécessaire."
                               TextWrapping="Wrap" Margin="0,12,0,0"
                               Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                </StackPanel>
            </Border>

        </StackPanel>

        <!-- =========================================================================
             FONCTIONNALITÉ : CHARGEMENT DE LA DÉTECTION
             ========================================================================= -->
        <StackPanel x:Name="DetectionLoadingPanel" Visibility="Collapsed" Margin="0,40,0,0">
            <TextBlock Text="Détection en cours…" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock Text="Lecture des informations de votre manette. Gardez le câble USB branché."
                       TextWrapping="Wrap" Margin="0,0,0,20"/>
            <ProgressBar Height="8" IsIndeterminate="True"
                         Foreground="{DynamicResource AppAccentBrush}"/>
        </StackPanel>
        <!-- =========================================================================
             FIN FONCTIONNALITÉ : CHARGEMENT DE LA DÉTECTION
             ========================================================================= -->

        <StackPanel x:Name="DetectionResultsPanel" Visibility="Collapsed">
            <TextBlock Text="ÉTAPE 3 / 5 · COMMANDES DÉTECTÉES"
                       Foreground="{DynamicResource AppAccentBrush}" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock Text="Votre manette est détectée" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock x:Name="DetectionStatusText" TextWrapping="Wrap" Margin="0,0,0,20"/>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Configurer les joysticks" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Ouvrez le test visuel pour identifier les axes et leur sens."
                               TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Button x:Name="StartJoystickTestButton" Content="Configurer les joysticks"
                            IsEnabled="False" HorizontalAlignment="Left" Padding="12,8"
                            Background="{DynamicResource AppPanelBrush}" Foreground="{DynamicResource AppForegroundBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}" Click="StartJoystickTestButton_Click"/>
                </StackPanel>
            </Border>

            <!-- =====================================================================
                 FONCTIONNALITÉ : VISUALISATION DES COMMANDES EN DIRECT
                 ===================================================================== -->
            <StackPanel x:Name="LiveCommandsPanel" Visibility="Collapsed">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="2. Boutons" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                        <TextBlock Text="Appuyez sur un bouton : sa carte s’allume."
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <ItemsControl x:Name="DetectedButtonsItems">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="130" Padding="10" Margin="0,0,8,8" CornerRadius="6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPressed}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource AppForegroundBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPressed}" Value="True">
                                                            <Setter Property="TextElement.Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Label}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,4"/>
                                            <TextBlock Text="{Binding State}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="3. Axes" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                        <TextBlock Text="Bougez les sticks ou les gâchettes pour voir les valeurs évoluer."
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <ItemsControl x:Name="DetectedAxesItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayValue}" FontWeight="SemiBold" Margin="12,0,0,0"/>
                                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Height="8" Margin="0,6,0,0"
                                                     Minimum="{Binding Minimum, Mode=OneWay}" Maximum="1" Value="{Binding Value, Mode=OneWay}"
                                                     Foreground="{DynamicResource AppAccentBrush}" Background="{DynamicResource AppBackgroundBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="4. Croix directionnelle" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                        <TextBlock x:Name="DetectedSwitchesText" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Les commandes sans nom et le rôle des axes restent à identifier. Cette lecture ne valide pas encore la configuration."
                           TextWrapping="Wrap" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
            </StackPanel>
            <!-- =====================================================================
                 FIN FONCTIONNALITÉ : VISUALISATION DES COMMANDES EN DIRECT
                 ===================================================================== -->
        </StackPanel>

        <!-- =========================================================================
             FIN FONCTIONNALITÉ : PRÉPARATION DE LA CONFIGURATION
             ========================================================================= -->

        <!-- =========================================================================
             FONCTIONNALITÉ : PAGE VISUELLE DES JOYSTICKS
             ========================================================================= -->
        <StackPanel x:Name="JoystickConfigurationPanel" Visibility="Collapsed">
            <TextBlock Text="ÉTAPE 4 / 5 · TEST DES JOYSTICKS" FontWeight="SemiBold"
                       Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,0,12"/>
            <TextBlock Text="Suivez le point cible" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Text="Placez le joystick demandé vers le cercle bleu, maintenez la position, puis validez. Laissez l’autre joystick et les gâchettes au repos."
                       TextWrapping="Wrap" Margin="0,0,0,20"/>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Name="JoystickInstructionText" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel x:Name="LeftJoystickDiagram" Grid.Column="0">
                            <TextBlock Text="Joystick gauche" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <Canvas Width="240" Height="240" HorizontalAlignment="Center">
                                <Ellipse Width="220" Height="220" Canvas.Left="10" Canvas.Top="10"
                                         Stroke="{DynamicResource AppBorderBrush}" StrokeThickness="1"/>
                                <Line X1="120" Y1="10" X2="120" Y2="230" Stroke="{DynamicResource AppBorderBrush}"/>
                                <Line X1="10" Y1="120" X2="230" Y2="120" Stroke="{DynamicResource AppBorderBrush}"/>
                                <Ellipse Width="6" Height="6" Canvas.Left="117" Canvas.Top="117" Fill="{DynamicResource AppSecondaryTextBrush}"/>
                                <Ellipse x:Name="LeftJoystickTarget" Width="22" Height="22" Canvas.Left="109" Canvas.Top="109"
                                         Stroke="{DynamicResource AppAccentBrush}" StrokeThickness="3"/>
                                <Ellipse x:Name="LeftJoystickPosition" Width="10" Height="10" Canvas.Left="115" Canvas.Top="115"
                                         Fill="{DynamicResource AppAccentBrush}" Visibility="Collapsed"/>
                            </Canvas>
                        </StackPanel>
                        <StackPanel x:Name="RightJoystickDiagram" Grid.Column="1">
                            <TextBlock Text="Joystick droit" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <Canvas Width="240" Height="240" HorizontalAlignment="Center">
                                <Ellipse Width="220" Height="220" Canvas.Left="10" Canvas.Top="10"
                                         Stroke="{DynamicResource AppBorderBrush}" StrokeThickness="1"/>
                                <Line X1="120" Y1="10" X2="120" Y2="230" Stroke="{DynamicResource AppBorderBrush}"/>
                                <Line X1="10" Y1="120" X2="230" Y2="120" Stroke="{DynamicResource AppBorderBrush}"/>
                                <Ellipse Width="6" Height="6" Canvas.Left="117" Canvas.Top="117" Fill="{DynamicResource AppSecondaryTextBrush}"/>
                                <Ellipse x:Name="RightJoystickTarget" Width="22" Height="22" Canvas.Left="109" Canvas.Top="109"
                                         Stroke="{DynamicResource AppAccentBrush}" StrokeThickness="3"/>
                                <Ellipse x:Name="RightJoystickPosition" Width="10" Height="10" Canvas.Left="115" Canvas.Top="115"
                                         Fill="{DynamicResource AppAccentBrush}" Visibility="Collapsed"/>
                            </Canvas>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Cercle bleu : position demandée. Après le test, le point plein montre la position détectée."
                               TextWrapping="Wrap" Foreground="{DynamicResource AppSecondaryTextBrush}" Margin="0,12,0,12"/>
                    <TextBlock Text="Les positions et valeurs affichées sont indicatives. Leur précision sera ajustée lors de l’intégration et de la validation du profil de cette manette par l’équipe de développement."
                               TextWrapping="Wrap" Foreground="{DynamicResource AppSecondaryTextBrush}" Margin="0,0,0,12"/>
                    <TextBlock x:Name="JoystickTestFeedbackText" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <StackPanel x:Name="JoystickTestActions" Orientation="Horizontal" Visibility="Collapsed">
                        <Button x:Name="CaptureJoystickPositionButton" Content="Valider la position" IsEnabled="False"
                                Padding="12,8" Background="{DynamicResource AppAccentBrush}" Foreground="White"
                                Click="CaptureJoystickPositionButton_Click"/>
                        <Button Content="Annuler le test" Padding="12,8" Margin="10,0,0,0"
                                Background="{DynamicResource AppPanelBrush}" Foreground="{DynamicResource AppForegroundBrush}"
                                Click="CancelJoystickTestButton_Click"/>
                    </StackPanel>
                    <Button x:Name="RestartJoystickTestButton" Content="Recommencer le test" Visibility="Collapsed"
                            HorizontalAlignment="Left" Padding="12,8" Click="StartJoystickTestButton_Click"
                            Background="{DynamicResource AppPanelBrush}" Foreground="{DynamicResource AppForegroundBrush}"/>
                    <Button x:Name="ContinueToButtonsButton" Content="Suivant : boutons et gâchettes"
                            IsEnabled="False" HorizontalAlignment="Left" Padding="12,8" Margin="0,12,0,0"
                            Click="ContinueToButtonsButton_Click" Background="{DynamicResource AppAccentBrush}" Foreground="White"/>
                </StackPanel>
            </Border>
        </StackPanel>
        <!-- =========================================================================
             FIN FONCTIONNALITÉ : PAGE VISUELLE DES JOYSTICKS
             ========================================================================= -->
        <!-- =========================================================================
             FONCTIONNALITÉ : PAGE DE CONFIGURATION DES BOUTONS
             ========================================================================= -->
        <StackPanel x:Name="ButtonConfigurationPanel" Visibility="Collapsed">
            <TextBlock Text="ÉTAPE 5 / 5 · BOUTONS ET GÂCHETTES" FontWeight="SemiBold"
                       Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,0,12"/>
            <TextBlock Text="Associez chaque commande" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock x:Name="ButtonModelText" TextWrapping="Wrap" Margin="0,0,0,16"/>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Name="ButtonInstructionText" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Viewbox Stretch="Uniform" MaxHeight="310" Margin="0,0,0,12">
                        <Canvas x:Name="ControllerButtonDiagram" Width="480" Height="330"/>
                    </Viewbox>
                    <TextBlock x:Name="ButtonTestFeedbackText" TextWrapping="Wrap" Margin="0,0,0,12"
                               Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                    <Button x:Name="BeginButtonTestButton" Content="Commencer le test des boutons"
                            HorizontalAlignment="Left" Padding="12,8" Click="BeginButtonTestButton_Click"
                            Background="{DynamicResource AppAccentBrush}" Foreground="White"/>
                    <WrapPanel x:Name="ButtonTestActions" Visibility="Collapsed">
                        <Button x:Name="SkipButtonInputButton" Content="Commande non détectée / absente"
                                Padding="12,8" Margin="0,0,0,8" Click="SkipButtonInputButton_Click"
                                Background="{DynamicResource AppPanelBrush}" Foreground="{DynamicResource AppForegroundBrush}"/>
                    </WrapPanel>
                    <Button x:Name="SaveButtonConfigurationButton" Content="Enregistrer les boutons"
                            IsEnabled="False" Visibility="Collapsed" HorizontalAlignment="Left" Padding="12,8"
                            Click="SaveButtonConfigurationButton_Click" Background="{DynamicResource AppAccentBrush}" Foreground="White"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Commandes de ce modèle" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
                    <ItemsControl x:Name="ButtonChecklistItems">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="195" Margin="0,0,10,12">
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Les commandes système, les boutons arrière ou certaines fonctions peuvent ne pas être exposés par Windows. Les commandes ignorées restent explicitement non associées. Enregistrez le profil localement pour le conserver après la fermeture de cette fenêtre."
                               TextWrapping="Wrap" Foreground="{DynamicResource AppSecondaryTextBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border x:Name="ProfileExportPanel" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Conserver et partager le profil" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                    <TextBlock Text="Le bouton Enregistrer conserve votre profil dans Documents\InputOS\profils. Envoyer le diagnostic transmet le modèle et les associations des commandes aux développeurs, sans compte GitHub. Une issue publique est créée automatiquement ; aucun nom de compte Windows ni identifiant unique du périphérique n’est envoyé."
                               TextWrapping="Wrap" Foreground="{DynamicResource AppSecondaryTextBrush}" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button Content="Enregistrer" Padding="12,8" Margin="0,0,8,8" Click="SaveLocalProfileButton_Click"
                                Background="{DynamicResource AppAccentBrush}" Foreground="White"/>
                        <Button x:Name="SendDiagnosticButton" Content="Envoyer le diagnostic" Padding="12,8" Margin="0,0,0,8" Click="SendDiagnosticButton_Click"
                                Background="{DynamicResource AppPanelBrush}" Foreground="{DynamicResource AppForegroundBrush}"/>
                    </WrapPanel>
                    <TextBlock x:Name="ProfileExportFeedbackText" Text="L’envoi se fait directement depuis InputOS. Le profil local et l’envoi du diagnostic sont indépendants."
                               TextWrapping="Wrap" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
        <!-- =========================================================================
             FIN FONCTIONNALITÉ : PAGE DE CONFIGURATION DES BOUTONS
             ========================================================================= -->
        </Grid>

        </ScrollViewer>

        <!-- =========================================================================
             FIN FONCTIONNALITÉ : NOM DE LA CONFIGURATION MANETTE
             ========================================================================= -->

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button x:Name="BackButton"
                    Content="Précédent"
                    Visibility="Collapsed"
                    Style="{StaticResource NavigationButtonStyle}"
                    Click="BackButton_Click"/>

            <Button Content="Annuler"
                    IsCancel="True"
                    Style="{StaticResource NavigationButtonStyle}"/>

            <Button x:Name="NextButton"
                    Content="Suivant"
                    IsEnabled="False"
                    Style="{StaticResource NavigationButtonStyle}"
                    Click="NextButton_Click"/>

        </StackPanel>

    </Grid>

</Window>
