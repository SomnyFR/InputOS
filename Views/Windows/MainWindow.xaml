<Window x:Class="InputOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InputOS"
        mc:Ignorable="d"

        Title="InputOS"
        Icon="/InputOS;component/Assets/Icons/iOSBlack.ico"
        Width="1200"
        Height="720"
        MinWidth="960"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"

        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}">

    <Window.Resources>

        <!-- =====================================================================
             STYLE
             ===================================================================== -->

        <Style x:Key="NavButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="14,11"/>

            <Setter Property="Margin"
                    Value="0,0,0,4"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

        </Style>


        <Style x:Key="NavGlyphStyle"
               TargetType="TextBlock">

            <Setter Property="FontFamily"
                    Value="Segoe MDL2 Assets"/>

            <Setter Property="FontSize"
                    Value="16"/>

            <Setter Property="Width"
                    Value="28"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource AppAccentBrush}"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>


        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{DynamicResource AppCardBrush}"/>

            <Setter Property="CornerRadius"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="22"/>

        </Style>


        <Style x:Key="SectionTitleStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource AppSecondaryTextBrush}"/>

            <Setter Property="Margin"
                    Value="0,0,0,16"/>

        </Style>


        <Style x:Key="InformationLabelStyle"
               TargetType="TextBlock">

            <Setter Property="Margin"
                    Value="0,0,12,12"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource AppSecondaryTextBrush}"/>

        </Style>


        <Style x:Key="InformationValueStyle"
               TargetType="TextBlock">

            <Setter Property="Margin"
                    Value="0,0,0,12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="TextWrapping"
                    Value="Wrap"/>

        </Style>


        <!-- Chaque manette est une carte verticale : nom en haut, image dessous. -->
        <Style TargetType="TreeViewItem">

            <Setter Property="Foreground"
                    Value="{DynamicResource AppForegroundBrush}"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Margin"
                    Value="0,0,16,16"/>

            <Setter Property="ItemsPanel">

                <Setter.Value>

                    <ItemsPanelTemplate>

                        <WrapPanel/>

                    </ItemsPanelTemplate>

                </Setter.Value>

            </Setter>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TreeViewItem">

                        <StackPanel>

                            <Border x:Name="CardBorder"
                                    Width="210"
                                    Height="240"
                                    Background="{DynamicResource AppCardBrush}"
                                    CornerRadius="14"
                                    Padding="20,18"
                                    BorderThickness="2"
                                    BorderBrush="Transparent">

                                <Grid>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Nom sur deux lignes au plus, puis ellipse ; le nom complet est dans l'info-bulle. -->
                                    <TextBlock Text="{TemplateBinding Header}"
                                               ToolTip="{TemplateBinding Header}"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="18"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="50"/>

                                    <Image x:Name="CardImage"
                                           Grid.Row="1"
                                           Source="{Binding (local:MainWindow.CardImage), RelativeSource={RelativeSource TemplatedParent}}"
                                           Stretch="Uniform"
                                           VerticalAlignment="Center"
                                           Margin="0,10,0,0"/>

                                    <TextBlock x:Name="GenericControllerGlyph"
                                               Grid.Row="1"
                                               Visibility="Collapsed"
                                               Text="&#xE7FC;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="80"
                                               Foreground="{DynamicResource AppSecondaryTextBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,10,0,0"/>

                                </Grid>

                            </Border>

                            <ItemsPresenter x:Name="ItemsHost"/>

                        </StackPanel>

                        <ControlTemplate.Triggers>

                            <Trigger SourceName="CardBorder"
                                     Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="CardBorder"
                                        Property="Background"
                                        Value="{DynamicResource AppCardHoverBrush}"/>

                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter TargetName="CardBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AppAccentBrush}"/>

                            </Trigger>

                            <!-- Pas d'illustration pour ce modèle : icône générique. -->
                            <Trigger Property="local:MainWindow.CardImage"
                                     Value="{x:Null}">

                                <Setter TargetName="GenericControllerGlyph"
                                        Property="Visibility"
                                        Value="Visible"/>

                            </Trigger>

                            <!-- Sans manette associée (groupe « Manettes », message vide) : simple texte, pas de carte. -->
                            <Trigger Property="Tag"
                                     Value="{x:Null}">

                                <Setter TargetName="CardBorder"
                                        Property="Width"
                                        Value="NaN"/>

                                <Setter TargetName="CardBorder"
                                        Property="Height"
                                        Value="NaN"/>

                                <Setter TargetName="CardBorder"
                                        Property="Background"
                                        Value="Transparent"/>

                                <Setter TargetName="CardBorder"
                                        Property="Padding"
                                        Value="0,0,0,8"/>

                                <!-- Titre non cliquable : ni sélection, ni contour. -->
                                <Setter TargetName="CardBorder"
                                        Property="IsHitTestVisible"
                                        Value="False"/>

                                <Setter Property="Focusable"
                                        Value="False"/>

                                <Setter TargetName="GenericControllerGlyph"
                                        Property="Visibility"
                                        Value="Collapsed"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- =========================================================================
             FONCTIONNALITÉ : BARRE LATÉRALE (ACTIONS)
             ========================================================================= -->

        <Border Grid.Row="0"
                Grid.Column="0"
                Background="#101216"
                Padding="18,26,18,18">

            <StackPanel>

                <TextBlock Text="InputOS"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="Détection et test de manettes"
                           Margin="0,2,0,32"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource AppSecondaryTextBrush}"/>


                <Button Style="{StaticResource NavButtonStyle}"
                        Click="RefreshButton_Click">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="&#xE72C;"
                                   Style="{StaticResource NavGlyphStyle}"/>

                        <TextBlock Text="Actualiser"/>

                    </StackPanel>

                </Button>


                <Button x:Name="TesterButton"
                        IsEnabled="False"
                        Style="{StaticResource NavButtonStyle}"
                        Click="TesterButton_Click">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="&#xE7FC;"
                                   Style="{StaticResource NavGlyphStyle}"/>

                        <TextBlock Text="Tester"/>

                    </StackPanel>

                </Button>


                <Button Style="{StaticResource NavButtonStyle}"
                        Click="SettingsButton_Click">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="&#xE713;"
                                   Style="{StaticResource NavGlyphStyle}"/>

                        <TextBlock Text="Paramètres"/>

                    </StackPanel>

                </Button>

            </StackPanel>

        </Border>

        <!-- =========================================================================
             FIN FONCTIONNALITÉ : BARRE LATÉRALE (ACTIONS)
             ========================================================================= -->


        <!-- =========================================================================
             FONCTIONNALITÉ : GESTION DES PÉRIPHÉRIQUES
             ========================================================================= -->

        <Grid Grid.Row="0"
              Grid.Column="1"
              Margin="32,28,32,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>


            <!-- =====================================================================
                 LISTE DES MANETTES
                 ===================================================================== -->

            <Grid Grid.Column="0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,22">

                    <TextBlock Text="Mes manettes"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Sélectionnez une manette pour afficher ses informations."
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource AppSecondaryTextBrush}"/>

                    <ProgressBar x:Name="RefreshProgressBar"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed"
                                 Height="3"
                                 Margin="0,14,0,0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource AppAccentBrush}"/>

                </StackPanel>


                <TreeView x:Name="DeviceTreeView"
                          Grid.Row="1"
                          Background="Transparent"
                          Foreground="{DynamicResource AppForegroundBrush}"
                          BorderThickness="0"
                          SelectedItemChanged="DeviceTreeView_SelectedItemChanged"/>

            </Grid>


            <!-- =====================================================================
                 INFORMATIONS MANETTE
                 ===================================================================== -->

            <Border Grid.Column="2"
                    Style="{StaticResource CardStyle}">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="INFORMATIONS"
                               Style="{StaticResource SectionTitleStyle}"/>


                    <!-- Illustration du modèle (DualShock 4 et manettes Xbox) ; masquée pour les autres. -->
                    <Image x:Name="DeviceImage"
                           Grid.Row="1"
                           Visibility="Collapsed"
                           Height="130"
                           Stretch="Uniform"
                           Margin="0,0,0,20"/>


                    <!-- FONCTIONNALITÉ : AVERTISSEMENT DE COMPATIBILITÉ -->

                    <Border x:Name="ControllerCompatibilityWarning"
                            Grid.Row="2"
                            Visibility="Collapsed"
                            Background="#2A2D35"
                            BorderBrush="{DynamicResource AppAccentBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14"
                            Margin="0,0,0,18">

                        <StackPanel>

                            <TextBlock x:Name="ControllerCompatibilityWarningText"
                                       Text="Manette non compatible. Aidez-nous à l’ajouter à InputOS."
                                       Foreground="{DynamicResource AppForegroundBrush}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>

                            <Button Content="Suggérer la manette"
                                    Margin="0,12,0,0"
                                    Click="SuggestControllerButton_Click"/>

                        </StackPanel>

                    </Border>


                    <ScrollViewer Grid.Row="3"
                                  VerticalScrollBarVisibility="Auto">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Nom"
                                       Style="{StaticResource InformationLabelStyle}"/>

                            <TextBlock x:Name="DeviceNameText"
                                       Grid.Row="0" Grid.Column="1"
                                       Text="-"
                                       Style="{StaticResource InformationValueStyle}"/>


                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="Type"
                                       Style="{StaticResource InformationLabelStyle}"/>

                            <TextBlock x:Name="DeviceTypeText"
                                       Grid.Row="1" Grid.Column="1"
                                       Text="-"
                                       Style="{StaticResource InformationValueStyle}"/>


                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="Connexion"
                                       Style="{StaticResource InformationLabelStyle}"/>

                            <TextBlock x:Name="DeviceConnectionText"
                                       Grid.Row="2" Grid.Column="1"
                                       Text="-"
                                       Style="{StaticResource InformationValueStyle}"/>


                            <TextBlock Grid.Row="3" Grid.Column="0"
                                       Text="VID"
                                       Style="{StaticResource InformationLabelStyle}"/>

                            <TextBlock x:Name="DeviceVidText"
                                       Grid.Row="3" Grid.Column="1"
                                       Text="-"
                                       Style="{StaticResource InformationValueStyle}"/>


                            <TextBlock Grid.Row="4" Grid.Column="0"
                                       Text="PID"
                                       Style="{StaticResource InformationLabelStyle}"/>

                            <TextBlock x:Name="DevicePidText"
                                       Grid.Row="4" Grid.Column="1"
                                       Text="-"
                                       Style="{StaticResource InformationValueStyle}"/>


                            <TextBlock Grid.Row="5" Grid.Column="0"
                                       Text="Boutons"
                                       Style="{StaticResource InformationLabelStyle}"/>

                            <TextBlock x:Name="DeviceButtonsText"
                                       Grid.Row="5" Grid.Column="1"
                                       Text="-"
                                       Style="{StaticResource InformationValueStyle}"/>


                            <TextBlock Grid.Row="6" Grid.Column="0"
                                       Text="Axes"
                                       Style="{StaticResource InformationLabelStyle}"/>

                            <TextBlock x:Name="DeviceAxesText"
                                       Grid.Row="6" Grid.Column="1"
                                       Text="-"
                                       Style="{StaticResource InformationValueStyle}"/>


                            <TextBlock Grid.Row="7" Grid.Column="0"
                                       Text="Firmware"
                                       Style="{StaticResource InformationLabelStyle}"/>

                            <TextBlock x:Name="DeviceFirmwareText"
                                       Grid.Row="7" Grid.Column="1"
                                       Text="Non disponible"
                                       Style="{StaticResource InformationValueStyle}"/>


                            <TextBlock Grid.Row="8" Grid.Column="0"
                                       Text="Batterie"
                                       Style="{StaticResource InformationLabelStyle}"/>

                            <TextBlock x:Name="DeviceBatteryText"
                                       Grid.Row="8" Grid.Column="1"
                                       Text="Non disponible"
                                       Style="{StaticResource InformationValueStyle}"/>


                            <TextBlock Grid.Row="9" Grid.Column="0"
                                       Text="État"
                                       Style="{StaticResource InformationLabelStyle}"/>

                            <TextBlock x:Name="DeviceStatusText"
                                       Grid.Row="9" Grid.Column="1"
                                       Text="Aucun périphérique sélectionné"
                                       Style="{StaticResource InformationValueStyle}"/>

                        </Grid>

                    </ScrollViewer>

                </Grid>

            </Border>

        </Grid>

        <!-- =========================================================================
             FIN FONCTIONNALITÉ : GESTION DES PÉRIPHÉRIQUES
             ========================================================================= -->


        <!-- =========================================================================
             FONCTIONNALITÉ : BARRE D'ÉTAT
             ========================================================================= -->

        <StatusBar Grid.Row="1"
                   Grid.ColumnSpan="2"
                   Background="#101216"
                   Foreground="{DynamicResource AppSecondaryTextBrush}"
                   BorderThickness="0"
                   Padding="12,4">

            <StatusBarItem>

                <TextBlock x:Name="StatusText"
                           Text="Prêt"/>

            </StatusBarItem>


            <Separator Background="{DynamicResource AppBorderBrush}"/>


            <StatusBarItem>

                <TextBlock Text="InputOS v0.1.0"/>

            </StatusBarItem>

        </StatusBar>

        <!-- =========================================================================
             FIN FONCTIONNALITÉ : BARRE D'ÉTAT
             ========================================================================= -->

    </Grid>

</Window>
