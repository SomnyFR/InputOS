<Window x:Class="InputOS.TesterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"

        Title="InputOS - Test de la manette"
        Icon="/InputOS;component/Assets/Icons/iOSWhite.ico"
        Width="900"
        Height="780"
        MinWidth="760"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"

        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}">

    <Window.Resources>

        <!-- =====================================================================
             STYLE
             ===================================================================== -->

        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{DynamicResource AppCardBrush}"/>

            <Setter Property="CornerRadius"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="22"/>

            <Setter Property="Margin"
                    Value="0,0,0,16"/>

        </Style>


        <Style x:Key="SectionTitleStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource AppSecondaryTextBrush}"/>

            <Setter Property="Margin"
                    Value="0,0,0,16"/>

        </Style>


        <Style x:Key="StickBorderStyle"
               TargetType="Border">

            <Setter Property="Width"
                    Value="200"/>

            <Setter Property="Height"
                    Value="200"/>

            <Setter Property="Background"
                    Value="{DynamicResource AppBackgroundBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource AppBorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="100"/>

        </Style>

    </Window.Resources>


    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="28,26,28,12">


            <!-- =========================================================================
                 FONCTIONNALITÉ : INFORMATIONS MANETTE
                 ========================================================================= -->

            <StackPanel Margin="0,0,0,22">

                <TextBlock x:Name="ControllerNameText"
                           Text="Manette"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock x:Name="ControllerHardwareText"
                           Text="VID : - | PID : -"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource AppSecondaryTextBrush}"/>

            </StackPanel>

            <!-- =========================================================================
                 FIN FONCTIONNALITÉ : INFORMATIONS MANETTE
                 ========================================================================= -->



            <!-- =========================================================================
                 FONCTIONNALITÉ : TEST DES STICKS
                 ========================================================================= -->

            <Border Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock Text="STICKS"
                               Style="{StaticResource SectionTitleStyle}"/>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <StackPanel Grid.Column="0"
                                    HorizontalAlignment="Center">

                            <TextBlock Text="Stick gauche"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,10"/>

                            <Border Style="{StaticResource StickBorderStyle}">

                                <Canvas x:Name="LeftStickCanvas"
                                        Width="198"
                                        Height="198">

                                    <Line X1="99"
                                          Y1="0"
                                          X2="99"
                                          Y2="198"
                                          Stroke="{DynamicResource AppBorderBrush}"
                                          StrokeThickness="1"/>

                                    <Line X1="0"
                                          Y1="99"
                                          X2="198"
                                          Y2="99"
                                          Stroke="{DynamicResource AppBorderBrush}"
                                          StrokeThickness="1"/>

                                    <Ellipse x:Name="LeftStickPoint"
                                             Width="10"
                                             Height="10"
                                             Fill="{DynamicResource AppAccentBrush}"
                                             Canvas.Left="94"
                                             Canvas.Top="94"/>

                                </Canvas>

                            </Border>


                            <CheckBox x:Name="LeftInvertYAxisCheckBox"
                                      Content="Inverser l'axe Y"
                                      Margin="0,14,0,0"
                                      HorizontalAlignment="Center"
                                      Foreground="{DynamicResource AppForegroundBrush}"
                                      Checked="LeftInvertYAxisCheckBox_Changed"
                                      Unchecked="LeftInvertYAxisCheckBox_Changed"/>

                        </StackPanel>


                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Center">

                            <TextBlock Text="Stick droit"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,10"/>

                            <Border Style="{StaticResource StickBorderStyle}">

                                <Canvas x:Name="RightStickCanvas"
                                        Width="198"
                                        Height="198">

                                    <Line X1="99"
                                          Y1="0"
                                          X2="99"
                                          Y2="198"
                                          Stroke="{DynamicResource AppBorderBrush}"
                                          StrokeThickness="1"/>

                                    <Line X1="0"
                                          Y1="99"
                                          X2="198"
                                          Y2="99"
                                          Stroke="{DynamicResource AppBorderBrush}"
                                          StrokeThickness="1"/>

                                    <Ellipse x:Name="RightStickPoint"
                                             Width="10"
                                             Height="10"
                                             Fill="{DynamicResource AppAccentBrush}"
                                             Canvas.Left="94"
                                             Canvas.Top="94"/>

                                </Canvas>

                            </Border>


                            <CheckBox x:Name="RightInvertYAxisCheckBox"
                                      Content="Inverser l'axe Y"
                                      Margin="0,14,0,0"
                                      HorizontalAlignment="Center"
                                      Foreground="{DynamicResource AppForegroundBrush}"
                                      Checked="RightInvertYAxisCheckBox_Changed"
                                      Unchecked="RightInvertYAxisCheckBox_Changed"/>

                        </StackPanel>

                    </Grid>

                </StackPanel>

            </Border>

            <!-- =========================================================================
                 FIN FONCTIONNALITÉ : TEST DES STICKS
                 ========================================================================= -->



            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- =====================================================================
                     FONCTIONNALITÉ : VALEURS DES AXES
                     ===================================================================== -->

                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock Text="AXES"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Margin="0,4">
                                    <Run Text="Left X : "
                                         Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                    <Run x:Name="LeftXText"
                                         Text="0.000"
                                         FontWeight="Bold"/>
                                </TextBlock>

                                <TextBlock Margin="0,4">
                                    <Run Text="Left Y : "
                                         Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                    <Run x:Name="LeftYText"
                                         Text="0.000"
                                         FontWeight="Bold"/>
                                </TextBlock>

                                <TextBlock Margin="0,4">
                                    <Run Text="L2 : "
                                         Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                    <Run x:Name="LeftTriggerText"
                                         Text="0.000"
                                         FontWeight="Bold"/>
                                </TextBlock>

                            </StackPanel>


                            <StackPanel Grid.Column="1">

                                <TextBlock Margin="0,4">
                                    <Run Text="Right X : "
                                         Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                    <Run x:Name="RightXText"
                                         Text="0.000"
                                         FontWeight="Bold"/>
                                </TextBlock>

                                <TextBlock Margin="0,4">
                                    <Run Text="Right Y : "
                                         Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                    <Run x:Name="RightYText"
                                         Text="0.000"
                                         FontWeight="Bold"/>
                                </TextBlock>

                                <TextBlock Margin="0,4">
                                    <Run Text="R2 : "
                                         Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                    <Run x:Name="RightTriggerText"
                                         Text="0.000"
                                         FontWeight="Bold"/>
                                </TextBlock>

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>

                <!-- =====================================================================
                     FIN FONCTIONNALITÉ : VALEURS DES AXES
                     ===================================================================== -->


                <!-- =====================================================================
                     FONCTIONNALITÉ : D-PAD
                     ===================================================================== -->

                <Border Grid.Column="2"
                        Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock Text="CROIX (D-PAD)"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <TextBlock Text="Direction actuelle"
                                   Foreground="{DynamicResource AppSecondaryTextBrush}"/>

                        <TextBlock x:Name="DPadText"
                                   Text="Neutre"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AppAccentBrush}"
                                   Margin="0,6,0,0"/>

                    </StackPanel>

                </Border>

                <!-- =====================================================================
                     FIN FONCTIONNALITÉ : D-PAD
                     ===================================================================== -->

            </Grid>



            <!-- =========================================================================
                 FONCTIONNALITÉ : TEST DES BOUTONS
                 ========================================================================= -->

            <Border Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock Text="BOUTONS"
                               Style="{StaticResource SectionTitleStyle}"/>

                    <!-- Les boutons sont générés dynamiquement en C# -->

                    <WrapPanel x:Name="ButtonsPanel"/>

                </StackPanel>

            </Border>

            <!-- =========================================================================
                 FIN FONCTIONNALITÉ : TEST DES BOUTONS
                 ========================================================================= -->


        </StackPanel>

    </ScrollViewer>

</Window>
