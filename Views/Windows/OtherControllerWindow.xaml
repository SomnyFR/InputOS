<Window x:Class="InputOS.OtherControllerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InputOS - Configuration libre"
        Icon="/InputOS;component/Assets/Icons/iOSBlack.ico"
        Width="860"
        Height="860"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}">

    <Grid Margin="28,24,28,20">

        <Grid.Resources>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Background" Value="{DynamicResource AppCardBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource AppCardHoverBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource AppForegroundBrush}"/>
                <Setter Property="Padding" Value="6,4"/>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- =========================================================================
             FONCTIONNALITÉ : CONFIGURATION LIBRE (MATÉRIEL NON LISTÉ)
             ========================================================================= -->

        <ScrollViewer x:Name="PageScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
            <StackPanel Margin="0,0,12,0">

                <TextBlock Text="CONFIGURATION LIBRE" Foreground="{DynamicResource AppAccentBrush}"
                           FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBlock Text="Décrivez votre matériel" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="Bougez une commande de votre matériel : InputOS indique laquelle a changé. Nommez-la, ignorez-la ou marquez-la comme absente. Aucune étape n’est obligatoire : il suffit de nommer au moins une entrée."
                           TextWrapping="Wrap" Margin="0,0,0,12"/>
                <TextBlock x:Name="ControllerInformationText" TextWrapping="Wrap"
                           Foreground="{DynamicResource AppSecondaryTextBrush}" Margin="0,0,0,12"/>

                <!-- Message d'erreur ou d'information, toujours visible : la page défile jusqu'à lui. -->
                <Border x:Name="MessageCard" Style="{StaticResource CardStyle}" Visibility="Collapsed"
                        BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="2">
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontWeight="SemiBold"/>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="PARAMÈTRES GLOBAUX" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Nom du matériel" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox x:Name="ProfileNameBox" Grid.Column="1" MaxLength="100" Margin="0,0,0,8"/>
                            <TextBlock Text="Type de matériel" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <ComboBox x:Name="ControllerTypeBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                                      SelectionChanged="ControllerTypeBox_SelectionChanged"/>
                            <TextBlock Text="Entrées à configurer" Grid.Row="2" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="Boutons" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="ButtonCountBox" Width="48" TextChanged="CountBox_TextChanged"/>
                                <TextBlock Text="Axes" VerticalAlignment="Center" Margin="16,0,6,0"/>
                                <TextBox x:Name="AxisCountBox" Width="48" TextChanged="CountBox_TextChanged"/>
                                <TextBlock Text="Switchs" VerticalAlignment="Center" Margin="16,0,6,0"/>
                                <TextBox x:Name="SwitchCountBox" Width="48" TextChanged="CountBox_TextChanged"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="CountHintText" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="DÉTECTION EN DIRECT" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="LastInputText" TextWrapping="Wrap" FontSize="16" Margin="0,0,0,8"/>
                        <Button x:Name="ResetDetectionButton" Content="Réinitialiser la détection"
                                HorizontalAlignment="Left" Click="ResetDetectionButton_Click"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="EntriesPanel"/>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuler" IsCancel="True" MinWidth="100" Margin="0,0,10,0"/>
            <Button x:Name="SaveButton" Content="Enregistrer le profil" MinWidth="140" Click="SaveButton_Click"/>
        </StackPanel>

        <!-- =========================================================================
             FIN FONCTIONNALITÉ : CONFIGURATION LIBRE (MATÉRIEL NON LISTÉ)
             ========================================================================= -->

    </Grid>

</Window>
