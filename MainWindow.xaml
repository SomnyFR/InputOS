<Window x:Class="InputOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InputOS"
        mc:Ignorable="d"

        Title="InputOS"
        Icon="Assets/Icons/iOSBlack.ico"
        Width="1000"
        Height="650"
        MinWidth="750"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"

        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- =========================================================================
             FONCTIONNALITÉ : BARRE D'OUTILS
             ========================================================================= -->

        <Grid Grid.Row="0"
              Margin="10">

            <!-- =====================================================================
                 STYLE
                 ===================================================================== -->

            <Grid.Resources>

                <Style x:Key="ToolbarButtonStyle"
                       TargetType="Button">

                    <Setter Property="Padding"
                            Value="10,5"/>

                    <Setter Property="Margin"
                            Value="0,0,5,0"/>

                    <Setter Property="MinWidth"
                            Value="90"/>

                    <Setter Property="Background"
                            Value="{DynamicResource AppPanelBrush}"/>

                    <Setter Property="Foreground"
                            Value="{DynamicResource AppForegroundBrush}"/>

                    <Setter Property="BorderBrush"
                            Value="{DynamicResource AppBorderBrush}"/>

                    <Setter Property="BorderThickness"
                            Value="1"/>

                </Style>

            </Grid.Resources>


            <!-- =====================================================================
                 INTERFACE
                 ===================================================================== -->

            <StackPanel Orientation="Horizontal">

                <Button Content="Actualiser"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="RefreshButton_Click"/>

                <Button Content="Tester"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="TesterButton_Click"/>

                <Button Content="Paramètres"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="SettingsButton_Click"/>

            </StackPanel>

        </Grid>

        <!-- =========================================================================
             FIN FONCTIONNALITÉ : BARRE D'OUTILS
             ========================================================================= -->



        <!-- =========================================================================
             FONCTIONNALITÉ : GESTION DES PÉRIPHÉRIQUES
             ========================================================================= -->

        <Grid Grid.Row="1"
              Margin="10,0,10,10">

            <!-- =====================================================================
                 STYLE
                 ===================================================================== -->

            <Grid.Resources>

                <Style x:Key="InformationLabelStyle"
                       TargetType="TextBlock">

                    <Setter Property="Margin"
                            Value="0,0,10,8"/>

                    <Setter Property="FontWeight"
                            Value="SemiBold"/>

                </Style>


                <Style x:Key="InformationValueStyle"
                       TargetType="TextBlock">

                    <Setter Property="Margin"
                            Value="0,0,0,8"/>

                    <Setter Property="TextWrapping"
                            Value="Wrap"/>

                </Style>


                <Style TargetType="TreeViewItem">

                    <Setter Property="Foreground"
                            Value="{DynamicResource AppForegroundBrush}"/>

                    <Setter Property="Background"
                            Value="Transparent"/>

                </Style>

            </Grid.Resources>


            <!-- =====================================================================
                 INTERFACE
                 ===================================================================== -->

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>



            <!-- =========================================================================
                 FONCTIONNALITÉ : LISTE DES MANETTES
                 ========================================================================= -->

            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Padding="0,8,0,0">

                <Grid>

                    <TextBlock Text="Périphériques"
                               Foreground="{DynamicResource AppForegroundBrush}"
                               Background="{DynamicResource AppBackgroundBrush}"
                               Margin="8,-17,0,0"
                               Padding="4,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"/>


                    <TreeView x:Name="DeviceTreeView"
                              Margin="8"
                              Background="{DynamicResource AppPanelBrush}"
                              Foreground="{DynamicResource AppForegroundBrush}"
                              BorderBrush="{DynamicResource AppBorderBrush}"
                              BorderThickness="1"
                              SelectedItemChanged="DeviceTreeView_SelectedItemChanged"/>

                </Grid>

            </Border>

            <!-- =========================================================================
                 FIN FONCTIONNALITÉ : LISTE DES MANETTES
                 ========================================================================= -->



            <!-- =========================================================================
                 FONCTIONNALITÉ : SÉPARATEUR
                 ========================================================================= -->

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent">

                <GridSplitter.Template>

                    <ControlTemplate TargetType="GridSplitter">

                        <Border Width="1"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource AppBorderBrush}"/>

                    </ControlTemplate>

                </GridSplitter.Template>

            </GridSplitter>

            <!-- =========================================================================
                 FIN FONCTIONNALITÉ : SÉPARATEUR
                 ========================================================================= -->



            <!-- =========================================================================
                 FONCTIONNALITÉ : INFORMATIONS MANETTE
                 ========================================================================= -->

            <Border Grid.Column="2"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Padding="0,8,0,0">

                <Grid>

                    <TextBlock Text="Informations"
                               Foreground="{DynamicResource AppForegroundBrush}"
                               Background="{DynamicResource AppBackgroundBrush}"
                               Margin="8,-17,0,0"
                               Padding="4,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"/>


                    <Grid Margin="15">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Nom :"
                                   Style="{StaticResource InformationLabelStyle}"/>

                        <TextBlock x:Name="DeviceNameText"
                                   Grid.Row="0"
                                   Grid.Column="1"
                                   Text="-"
                                   Style="{StaticResource InformationValueStyle}"/>


                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="Type :"
                                   Style="{StaticResource InformationLabelStyle}"/>

                        <TextBlock x:Name="DeviceTypeText"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   Text="-"
                                   Style="{StaticResource InformationValueStyle}"/>


                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="Connexion :"
                                   Style="{StaticResource InformationLabelStyle}"/>

                        <TextBlock x:Name="DeviceConnectionText"
                                   Grid.Row="2"
                                   Grid.Column="1"
                                   Text="-"
                                   Style="{StaticResource InformationValueStyle}"/>


                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Text="VID :"
                                   Style="{StaticResource InformationLabelStyle}"/>

                        <TextBlock x:Name="DeviceVidText"
                                   Grid.Row="3"
                                   Grid.Column="1"
                                   Text="-"
                                   Style="{StaticResource InformationValueStyle}"/>


                        <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   Text="PID :"
                                   Style="{StaticResource InformationLabelStyle}"/>

                        <TextBlock x:Name="DevicePidText"
                                   Grid.Row="4"
                                   Grid.Column="1"
                                   Text="-"
                                   Style="{StaticResource InformationValueStyle}"/>


                        <TextBlock Grid.Row="5"
                                   Grid.Column="0"
                                   Text="Boutons :"
                                   Style="{StaticResource InformationLabelStyle}"/>

                        <TextBlock x:Name="DeviceButtonsText"
                                   Grid.Row="5"
                                   Grid.Column="1"
                                   Text="-"
                                   Style="{StaticResource InformationValueStyle}"/>


                        <TextBlock Grid.Row="6"
                                   Grid.Column="0"
                                   Text="Axes :"
                                   Style="{StaticResource InformationLabelStyle}"/>

                        <TextBlock x:Name="DeviceAxesText"
                                   Grid.Row="6"
                                   Grid.Column="1"
                                   Text="-"
                                   Style="{StaticResource InformationValueStyle}"/>


                        <TextBlock Grid.Row="7"
                                   Grid.Column="0"
                                   Text="Firmware :"
                                   Style="{StaticResource InformationLabelStyle}"/>

                        <TextBlock x:Name="DeviceFirmwareText"
                                   Grid.Row="7"
                                   Grid.Column="1"
                                   Text="Non disponible"
                                   Style="{StaticResource InformationValueStyle}"/>


                        <TextBlock Grid.Row="8"
                                   Grid.Column="0"
                                   Text="Batterie :"
                                   Style="{StaticResource InformationLabelStyle}"/>

                        <TextBlock x:Name="DeviceBatteryText"
                                   Grid.Row="8"
                                   Grid.Column="1"
                                   Text="Non disponible"
                                   Style="{StaticResource InformationValueStyle}"/>


                        <TextBlock Grid.Row="9"
                                   Grid.Column="0"
                                   Text="État :"
                                   Style="{StaticResource InformationLabelStyle}"/>

                        <TextBlock x:Name="DeviceStatusText"
                                   Grid.Row="9"
                                   Grid.Column="1"
                                   Text="Aucun périphérique sélectionné"
                                   Style="{StaticResource InformationValueStyle}"/>

                    </Grid>

                </Grid>

            </Border>

            <!-- =========================================================================
                 FIN FONCTIONNALITÉ : INFORMATIONS MANETTE
                 ========================================================================= -->

        </Grid>

        <!-- =========================================================================
             FIN FONCTIONNALITÉ : GESTION DES PÉRIPHÉRIQUES
             ========================================================================= -->



        <!-- =========================================================================
             FONCTIONNALITÉ : BARRE D'ÉTAT
             ========================================================================= -->

        <StatusBar Grid.Row="2"
                   Background="{DynamicResource AppPanelBrush}"
                   Foreground="{DynamicResource AppForegroundBrush}"
                   BorderBrush="{DynamicResource AppBorderBrush}"
                   BorderThickness="1,1,0,0">

            <!-- =====================================================================
                 STYLE
                 ===================================================================== -->

            <!-- Style Windows par défaut -->


            <!-- =====================================================================
                 INTERFACE
                 ===================================================================== -->

            <StatusBarItem>

                <TextBlock x:Name="StatusText"
                           Text="Prêt"/>

            </StatusBarItem>


            <Separator Background="{DynamicResource AppBorderBrush}"/>


            <StatusBarItem>

                <TextBlock Text="InputOS v0.1.0"/>

            </StatusBarItem>

        </StatusBar>

        <!-- =========================================================================
             FIN FONCTIONNALITÉ : BARRE D'ÉTAT
             ========================================================================= -->

    </Grid>

</Window>