<Window x:Class="InputOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InputOS"
        mc:Ignorable="d"

        Title="InputOS"
        Width="900"
        Height="600"
        MinWidth="700"
        MinHeight="450"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- =========================================================================
     FONCTIONNALITÉ : BARRE D'OUTILS
     ========================================================================= -->

<Grid Grid.Row="0"
      Margin="10">

    <!-- =====================================================================
         STYLE
         ===================================================================== -->

    <Grid.Resources>

        <Style x:Key="ToolbarButtonStyle"
               TargetType="Button">

            <Setter Property="Padding"
                    Value="10,5"/>

            <Setter Property="Margin"
                    Value="0,0,5,0"/>

            <Setter Property="MinWidth"
                    Value="90"/>

        </Style>

    </Grid.Resources>


    <!-- =====================================================================
         INTERFACE
         ===================================================================== -->

    <StackPanel Orientation="Horizontal">

        <Button Content="Actualiser"
                Style="{StaticResource ToolbarButtonStyle}"/>

        <Button Content="Informations"
                Style="{StaticResource ToolbarButtonStyle}"/>

        <Button Content="Tester"
                Style="{StaticResource ToolbarButtonStyle}"/>

        <Button Content="Paramètres"
                Style="{StaticResource ToolbarButtonStyle}"/>

    </StackPanel>

</Grid>

<!-- =========================================================================
     FIN FONCTIONNALITÉ : BARRE D'OUTILS
     ========================================================================= -->



        <!-- =========================================================================
             FONCTIONNALITÉ : LISTE DES MANETTES
             ========================================================================= -->

        <Grid Grid.Row="1"
              Margin="10,0,10,10">

            <!-- =====================================================================
                 STYLE
                 ===================================================================== -->

            <Grid.Resources>

                <Style x:Key="DeviceTreeStyle"
                       TargetType="TreeView">

                    <Setter Property="BorderThickness"
                            Value="1"/>

                    <Setter Property="Padding"
                            Value="5"/>

                </Style>

            </Grid.Resources>


            <!-- =====================================================================
                 INTERFACE
                 ===================================================================== -->

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- =====================================================================
                 FONCTIONNALITÉ : ARBORESCENCE DES PÉRIPHÉRIQUES
                 ===================================================================== -->

            <GroupBox Grid.Column="0"
                      Header="Périphériques">

                <TreeView Style="{StaticResource DeviceTreeStyle}">

                    <TreeViewItem Header="Manettes">

                        <TreeViewItem Header="Aucune manette détectée"/>

                    </TreeViewItem>

                </TreeView>

            </GroupBox>

            <!-- =========================================================================
                 FIN FONCTIONNALITÉ : ARBORESCENCE DES PÉRIPHÉRIQUES
                 ========================================================================= -->



            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"/>



            <!-- =========================================================================
                 FONCTIONNALITÉ : INFORMATIONS DU PÉRIPHÉRIQUE
                 ========================================================================= -->

            <GroupBox Grid.Column="2"
                      Header="Informations">

                <Grid Margin="10">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Nom :"
                               Margin="0,0,10,8"/>

                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               Text="-"
                               Margin="0,0,0,8"/>


                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="Type :"
                               Margin="0,0,10,8"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Text="-"
                               Margin="0,0,0,8"/>


                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Connexion :"
                               Margin="0,0,10,8"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="1"
                               Text="-"
                               Margin="0,0,0,8"/>


                    <TextBlock Grid.Row="3"
                               Grid.Column="0"
                               Text="VID :"
                               Margin="0,0,10,8"/>

                    <TextBlock Grid.Row="3"
                               Grid.Column="1"
                               Text="-"
                               Margin="0,0,0,8"/>


                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               Text="PID :"
                               Margin="0,0,10,8"/>

                    <TextBlock Grid.Row="4"
                               Grid.Column="1"
                               Text="-"
                               Margin="0,0,0,8"/>


                    <TextBlock Grid.Row="5"
                               Grid.Column="0"
                               Text="Firmware :"
                               Margin="0,0,10,8"/>

                    <TextBlock Grid.Row="5"
                               Grid.Column="1"
                               Text="-"
                               Margin="0,0,0,8"/>


                    <TextBlock Grid.Row="6"
                               Grid.Column="0"
                               Text="Batterie :"
                               Margin="0,0,10,8"/>

                    <TextBlock Grid.Row="6"
                               Grid.Column="1"
                               Text="-"
                               Margin="0,0,0,8"/>


                    <TextBlock Grid.Row="7"
                               Grid.Column="0"
                               Text="État :"
                               Margin="0,0,10,8"/>

                    <TextBlock Grid.Row="7"
                               Grid.Column="1"
                               Text="Aucun périphérique sélectionné"
                               Margin="0,0,0,8"/>

                </Grid>

            </GroupBox>

            <!-- =========================================================================
                 FIN FONCTIONNALITÉ : INFORMATIONS DU PÉRIPHÉRIQUE
                 ========================================================================= -->

        </Grid>

        <!-- =========================================================================
             FIN FONCTIONNALITÉ : LISTE DES MANETTES
             ========================================================================= -->



        <!-- =========================================================================
             FONCTIONNALITÉ : BARRE D'ÉTAT
             ========================================================================= -->

        <StatusBar Grid.Row="2">

            <!-- =====================================================================
                 STYLE
                 ===================================================================== -->

            <!-- Aucun style spécifique pour le moment -->


            <!-- =====================================================================
                 INTERFACE
                 ===================================================================== -->

            <StatusBarItem>

                <TextBlock Text="Prêt"/>

            </StatusBarItem>

            <Separator/>

            <StatusBarItem>

                <TextBlock Text="InputOS v0.1.0"/>

            </StatusBarItem>

        </StatusBar>

        <!-- =========================================================================
             FIN FONCTIONNALITÉ : BARRE D'ÉTAT
             ========================================================================= -->

    </Grid>

</Window>